---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import RecursosHero from "../../components/RecursosHero.astro";
import BrandKitSection from "../../components/BrandKitSection.astro";
import ResourceLinkGrid from "../../components/ResourceLinkGrid.astro";
import PapersGrid from "../../components/PapersGrid.astro";
import PartnersSlider from "../../components/PartnersSlider.astro";
import Footer from "../../components/Footer.astro";

const oficiales = [
	{ title: "Ethereum Org." },
	{ title: "Ethereum foundation" },
	{ title: "Ethereum Glossary" },
];

const ethereumResources = [
	{ title: "Ethereum Org." },
	{ title: "Ethereum foundation" },
	{ title: "Ethereum Glossary" },
	{ title: "Ethereum Org." },
	{ title: "Ethereum foundation" },
	{ title: "Ethereum Glossary" },
];

const aprenderResources = [
	{ title: "Ethereum Org." },
	{ title: "Ethereum foundation" },
	{ title: "Ethereum Glossary" },
	{ title: "Ethereum Glossary" },
	{ title: "Ethereum Org." },
	{ title: "Ethereum foundation" },
	{ title: "Ethereum Glossary" },
	{ title: "Ethereum Glossary" },
];

const papers = [
	{ title: "Ethereum White paper" },
	{ title: "Ethereum White paper", subtitle: "Spanish" },
	{ title: "Yellow paper" },
	{ title: "Mastering Ethereum" },
];
---

<BaseLayout title="Resources - Ethereum Lima">
	<Navbar />
	<main>
		<RecursosHero />
		<BrandKitSection />

		<ResourceLinkGrid
			title="Official Ethereum Websites"
			resources={oficiales}
		/>

		<ResourceLinkGrid title="Ethereum" resources={ethereumResources} />

		<ResourceLinkGrid
			title="Learn to Code"
			description="Resources to start your journey in Web3 development."
			resources={aprenderResources}
			variant="light"
		/>

		<PapersGrid title="Books and Papers" papers={papers} />

		<PartnersSlider />
	</main>
</BaseLayout>
