---
import SectionContainer from "./SectionContainer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SectionContainer class="bg-neutral-100 flex items-center min-h-screen pt-40 pb-24">
	<div class="flex flex-col gap-12 w-full max-w-4xl mx-auto">
		<h2 class="text-3xl sm:text-4xl md:text-6xl font-bold text-center leading-[1] tracking-tighter">
			{t('quote.text')}
		</h2>
	</div>
</SectionContainer>
