---
interface Props {
	name: string;
	role: string;
	image?: string;
	linkedin?: string;
	twitter?: string;
}

const { name, role, image, linkedin, twitter } = Astro.props;
const fallbackImage = "/eth-lima-web/logo/EthLima.webp";

// Verificar si hay redes sociales para ajustar el ancho del cargo
const hasSocials = (linkedin && linkedin !== "") || (twitter && twitter !== "");
---

<div class="flex flex-col gap-2.5 w-full max-w-[210px] group items-start">
	<!-- Nombre (Una sola línea, color web, izquierda) -->
	<h3 class="text-base md:text-lg font-bold text-primary leading-tight text-left w-full truncate px-1">
		{name}
	</h3>

	<!-- Imagen (1x1, al centro) -->
	<div class="aspect-square w-full bg-neutral-50 rounded-[20px] overflow-hidden relative border border-neutral-100 shadow-sm transition-all duration-500 group-hover:shadow-md group-hover:border-primary/20">
		<img 
			src={image && image !== "" ? image : fallbackImage} 
			alt={name} 
			class={`w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 ${!image || image === "" ? "p-6 object-contain opacity-50" : ""}`}
		/>
	</div>

	<!-- Cargo y Redes (Cargo izquierda, Redes derecha) -->
	<div class="flex items-center justify-between gap-2 w-full mt-0.5 px-1">
		<p class="text-[10px] sm:text-xs md:text-sm font-medium text-primary/70 leading-none truncate flex-grow">
			{role}
		</p>
		
		{hasSocials && (
			<div class="flex gap-2 md:gap-3 shrink-0">
				{linkedin && linkedin !== "" && (
					<a href={linkedin} target="_blank" rel="noopener noreferrer" class="text-primary hover:scale-110 transition-transform" aria-label="LinkedIn">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="md:w-[18px] md:h-[18px]" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
					</a>
				)}
				{twitter && twitter !== "" && (
					<a href={twitter} target="_blank" rel="noopener noreferrer" class="text-primary hover:scale-110 transition-transform" aria-label="X (Twitter)">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" class="md:w-[18px] md:h-[18px]" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
					</a>
				)}
			</div>
		)}
	</div>
</div>
