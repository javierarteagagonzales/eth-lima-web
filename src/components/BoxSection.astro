---
import SectionContainer from "./SectionContainer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SectionContainer class="min-h-screen pt-40 pb-24 flex items-center justify-center overflow-hidden relative">
	<div id="scrolling-background" class="absolute inset-0 -z-10 bg-cover bg-center"></div>
	<div class="flex flex-col gap-6 md:gap-10 w-full max-w-5xl mx-auto">
		<h2 class="text-3xl md:text-5xl font-bold text-center mx-auto leading-[0.85] tracking-tighter text-white">
			{t('box.title')}
		</h2>

		<div class="w-full aspect-[16/9] md:aspect-[21/9] bg-[#444444] rounded-[30px] md:rounded-[50px] shadow-2xl relative overflow-hidden flex items-center justify-between px-6 md:px-8 group">
			<button class="w-8 h-8 md:w-10 md:h-10 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center text-white hover:bg-white/20 transition-all">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
			</button>
			
			<div class="absolute bottom-6 md:bottom-8 left-1/2 -translate-x-1/2 flex gap-2">
				<div class="w-1.5 h-1.5 md:w-2 md:h-2 bg-white rounded-full"></div>
				<div class="w-1.5 h-1.5 md:w-2 md:h-2 bg-white/30 rounded-full"></div>
				<div class="w-1.5 h-1.5 md:w-2 md:h-2 bg-white/30 rounded-full"></div>
			</div>

			<button class="w-8 h-8 md:w-10 md:h-10 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center text-white hover:bg-white/20 transition-all">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
			</button>
		</div>
	</div>
</SectionContainer>

<style>
	#scrolling-background {
		background-image: url('/eth-lima-web/img/fondoBoxSection.webp');
		background-repeat: no-repeat;
		background-size: cover;
		transition: opacity 0.5s ease-in-out;
	}

	@media (min-width: 768px) {
		#scrolling-background.animate-bg {
			background-image: url('/eth-lima-web/img/fondoBoxSection-large.avif');
			background-repeat: repeat-x;
			background-size: auto 100%;
			/* Modifica el tiempo (60s) para aumentar o disminuir la velocidad */
			animation: scrollBackground 60s linear infinite;
		}
	}

	@keyframes scrollBackground {
		from { background-position: 0 0; }
		to { background-position: -2000px 0; }
	}
</style>

<script>
	// Carga el fondo después de que todo el contenido inicial esté listo
	window.addEventListener('load', () => {
		const bg = document.getElementById('scrolling-background');
		if (bg) {
			bg.classList.add('animate-bg');
		}
	});
</script>
