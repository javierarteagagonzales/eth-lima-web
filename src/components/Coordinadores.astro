---
import SectionContainer from "./SectionContainer.astro";
import CoordinadorCard from "./CoordinadorCard.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const coordinadores = [
	{
		name: "Javier Arteaga",
		role: "Tecnología y Educación",
		image: "/eth-lima-web/img/coordinator/jargo.webp", // /eth-lima-web/img/team/nombre.avif
		linkedin: "https://linkedin.com",
		twitter: "https://twitter.com",
	},
	{
		name: "Alexandra Jaime",
		role: "Proyecto",
		image: "",
		linkedin: "https://linkedin.com",
		twitter: "https://twitter.com",
	},
	{
		name: "Audi",
		role: "Comunicaciones y Marketing",
		image: "",
		linkedin: "https://linkedin.com",
		twitter: "https://twitter.com",
	},
	{
		name: "Hristro",
		role: "Logística",
		image: "",
		linkedin: "https://linkedin.com",
		twitter: "https://twitter.com",
	},
	{
		name: "Ángel Chavez",
		role: "Logística",
		image: "",
		linkedin: "https://linkedin.com",
		twitter: "https://twitter.com",
	},
	{
		name: "Paul",
		role: "Bienestar",
		image: "",
		linkedin: "https://linkedin.com",
		twitter: "https://twitter.com",
	},
];
---

<SectionContainer
	id="coordinadores"
	class="flex flex-col items-center justify-center min-h-screen pt-32 pb-24 bg-[var(--color-bg-1)]"
>
	<div class="flex flex-col gap-12 w-full max-w-6xl mx-auto px-4 md:px-8">
		<div class="flex flex-col items-center text-center gap-4">
			<h2
				class="text-4xl md:text-5xl lg:text-6xl font-bold text-[#0F172A] leading-none uppercase tracking-tighter"
			>
				{t("coordinadores.title")}
			</h2>
			<div class="w-24 h-1 bg-primary rounded-full"></div>
		</div>

		<!-- Grid de 3 columnas para Coordinadores -->
		<div
			class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-8"
		>
			{
				coordinadores.map((member) => (
					<div class="flex justify-center w-full">
						<CoordinadorCard {...member} />
					</div>
				))
			}
		</div>
	</div>
</SectionContainer>
