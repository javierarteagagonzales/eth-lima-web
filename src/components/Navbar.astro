---
import Logo from "./Logo.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
	{ href: lang === 'es' ? `${base}recursos` : `${base}en/recursos`, label: t('nav.recursos') },
	{ href: lang === 'es' ? `${base}team` : `${base}en/team`, label: t('nav.team') },
	{ href: lang === 'es' ? `${base}eventos` : `${base}en/eventos`, label: t('nav.eventos') },
	{ href: lang === 'es' ? `${base}puqi` : `${base}en/puqi`, label: t('nav.puqi') },
	{ href: lang === 'es' ? `${base}contacto` : `${base}en/contacto`, label: t('nav.contacto') },
];

const currentPath = Astro.url.pathname;
const toggleLangHref = lang === 'es' 
	? currentPath.replace(base, `${base}en/`).replace(/\/+$/, '') 
	: currentPath.replace(`${base}en/`, base).replace(/\/+$/, '');

---

<header class="fixed top-0 left-0 w-full z-50 flex justify-center p-4">
	<nav class="max-w-5xl w-full bg-black/90 backdrop-blur-md text-white rounded-full px-6 md:px-8 py-3 flex items-center justify-between border border-white/10 shadow-lg">
		<div class="flex items-center gap-2">
			<a href={lang === 'es' ? base : `${base}en/`} class="flex items-center gap-2 group">
				<Logo className="h-8 md:h-10" color="white" />
			</a>
		</div>

		<!-- Desktop Menu -->
		<div class="hidden md:flex items-center gap-6">
			<ul class="flex items-center gap-6">
				{navLinks.map(link => (
					<li>
						<a href={link.href} class="text-[11px] font-bold uppercase tracking-widest hover:text-[var(--color-primary)] transition-colors">
							{link.label}
						</a>
					</li>
				))}
			</ul>
			
			<div class="h-4 w-[1px] bg-white/20 ml-2"></div>
			
			<a href={toggleLangHref} class="text-[11px] font-bold uppercase tracking-widest hover:text-[var(--color-primary-light)] transition-colors px-2 py-1 rounded border border-white/10 bg-white/5">
				{lang === 'es' ? 'EN' : 'ES'}
			</a>
		</div>

		<!-- Mobile Menu Button -->
		<div class="flex items-center gap-2 md:hidden">
			<a href={toggleLangHref} class="text-[11px] font-bold uppercase tracking-widest hover:text-[var(--color-primary-light)] transition-colors px-3 py-1.5 rounded border border-white/10 bg-white/5">
				{lang === 'es' ? 'EN' : 'ES'}
			</a>
			<button id="mobile-menu-btn" class="p-2 text-white" aria-label="Menu">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
			</button>
		</div>
	</nav>

	<!-- Mobile Menu Overlay -->
	<div id="mobile-menu" class="fixed inset-0 bg-black z-[-1] flex flex-col items-center justify-center gap-8 translate-x-full transition-transform duration-500 md:hidden">
		<Logo className="h-16 md:h-20 mb-8" color="white" />
		<ul class="flex flex-col items-center gap-6">
			{navLinks.map(link => (
				<li>
					<a href={link.href} class="text-xl font-bold uppercase tracking-tighter text-white hover:text-[var(--color-primary-light)] transition-colors">
						{link.label}
					</a>
				</li>
			))}
		</ul>
		<button id="close-menu" class="absolute top-8 right-8 text-white p-2">
			<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
		</button>
	</div>
</header>

<script>
	const menuBtn = document.getElementById('mobile-menu-btn');
	const closeBtn = document.getElementById('close-menu');
	const mobileMenu = document.getElementById('mobile-menu');

	menuBtn?.addEventListener('click', () => {
		mobileMenu?.classList.remove('translate-x-full');
	});

	closeBtn?.addEventListener('click', () => {
		mobileMenu?.classList.add('translate-x-full');
	});
</script>
