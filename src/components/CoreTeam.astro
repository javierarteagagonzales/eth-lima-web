---
import SectionContainer from "./SectionContainer.astro";
import TeamMemberCard from "./TeamMemberCard.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const coreTeam = [
	{
		name: "Yamille Celis",
		role: "Lead Eth Lima",
		image: "/eth-lima-web/img/team/yamille.png", // Ubicación sugerida: /img/team/nombre.avif
		linkedin: "https://www.linkedin.com/in/cycelisgomez/",
		twitter: "https://x.com/yamiyami_eth",
	},
	{
		name: "Criss Valladares",
		role: "Operations & Logistics",
		image: "/eth-lima-web/img/team/Criss.webp",
		linkedin: "https://www.linkedin.com/in/criss-valladares-6bb765198/",
		twitter: "https://x.com/mimetista_eth",
	},
	{
		name: "Adolfo Morán",
		role: "Legal",
		image: "/eth-lima-web/img/team/adolfo.webp",
		linkedin: "https://www.linkedin.com/in/adolfo-moran/",
		twitter: "",
	},
	{
		name: "Arturo Mena",
		role: "Technical Education",
		image: "/eth-lima-web/img/team/arturo.webp",
		linkedin: "",
		twitter: "",
	},
	{
		name: "Edwin Fernández",
		role: "DeFi & Onchain Operations",
		image: "/eth-lima-web/img/team/blid.webp",
		linkedin: "https://www.linkedin.com/in/edwin-fernandez-grau/",
		twitter: "https://x.com/blid_eth",
	},
	{
		name: "Kiara Henríquez",
		role: "Public Relations",
		image: "/eth-lima-web/img/team/kiara.webp",
		linkedin: "https://www.linkedin.com/in/kiarahenriquez/",
		twitter: "",
	},
];
---

<SectionContainer
	id="core-team"
	class="flex flex-col items-center justify-center min-h-screen pt-40 pb-24 bg-[var(--color-bg-0)]"
>
	<div class="flex flex-col gap-12 w-full max-w-4xl mx-auto px-4">
		<div class="flex items-center gap-4">
			<h2
				class="text-4xl md:text-5xl font-bold text-[#0F172A] leading-none uppercase tracking-tighter"
			>
				{t("coreTeam.title")}
				<span class="text-primary italic"
					>{t("coreTeam.subtitle")}
				</span>
			</h2>
			<div class="h-[1px] flex-grow bg-neutral-100 hidden md:block"></div>
		</div>

		<div
			class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-10 gap-x-8 md:gap-x-12 mx-auto"
		>
			{
				coreTeam.map((member) => (
					<div class="flex justify-center w-full">
						<TeamMemberCard {...member} />
					</div>
				))
			}
		</div>
	</div>
</SectionContainer>
