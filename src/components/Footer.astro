---
import Logo from "./Logo.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const base = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getPath = (path: string) => lang === 'es' ? `${base}${path}` : `${base}en/${path}`;
---

<footer class="bg-black text-white py-16 px-4">
	<div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between gap-12">
		<div class="flex flex-col gap-6">
			<a href={lang === 'es' ? base : `${base}en/`} class="group">
				<Logo className="h-8 md:h-10" color="white" />
			</a>
			<p class="text-neutral-400 max-w-xs text-sm">
				{t('footer.description')}
			</p>
			<div class="flex gap-4">
				<a href="#" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-primary transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
				</a>
				<a href="#" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-primary transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
				</a>
				<a href="#" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-primary transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
				</a>
			</div>
		</div>

		<div class="grid grid-cols-2 sm:grid-cols-3 gap-8">
			<div class="flex flex-col gap-4">
				<h4 class="font-bold text-sm uppercase tracking-widest text-neutral-500">{t('footer.community')}</h4>
				<ul class="flex flex-col gap-2 text-sm text-neutral-300">
					<li><a href={getPath('team')} class="hover:text-primary transition-colors">{t('footer.about')}</a></li>
					<li><a href={lang === 'es' ? base : `${base}en/`} class="hover:text-primary transition-colors">{t('footer.manifesto')}</a></li>
					<li><a href={getPath('eventos')} class="hover:text-primary transition-colors">{t('footer.events')}</a></li>
				</ul>
			</div>
			<div class="flex flex-col gap-4">
				<h4 class="font-bold text-sm uppercase tracking-widest text-neutral-500">{t('footer.resources')}</h4>
				<ul class="flex flex-col gap-2 text-sm text-neutral-300">
					<li><a href={getPath('recursos')} class="hover:text-primary transition-colors">{t('footer.training')}</a></li>
					<li><a href={getPath('recursos')} class="hover:text-primary transition-colors">{t('footer.courses')}</a></li>
					<li><a href={getPath('recursos')} class="hover:text-primary transition-colors">{t('footer.blog')}</a></li>
				</ul>
			</div>
			<div class="flex flex-col gap-4">
				<h4 class="font-bold text-sm uppercase tracking-widest text-neutral-500">{t('footer.legal')}</h4>
				<ul class="flex flex-col gap-2 text-sm text-neutral-300">
					<li><a href={getPath('contacto')} class="hover:text-primary transition-colors">{t('footer.privacy')}</a></li>
					<li><a href={getPath('contacto')} class="hover:text-primary transition-colors">{t('footer.terms')}</a></li>
				</ul>
			</div>
		</div>
	</div>

	<div class="max-w-7xl mx-auto mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-neutral-500">
		<p>{t('footer.rights')}</p>
		<p>{t('footer.made')}</p>
	</div>
</footer>
