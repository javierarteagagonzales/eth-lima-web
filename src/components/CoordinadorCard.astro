---
interface Props {
	name: string;
	role: string;
	image?: string;
	linkedin?: string;
	twitter?: string;
}

const { name, role, image, linkedin, twitter } = Astro.props;
const fallbackImage = "/eth-lima-web/logo/EthLima.webp";

const hasSocials = (linkedin && linkedin !== "") || (twitter && twitter !== "");
---

<div class="flex items-center gap-4 bg-white p-3 rounded-[24px] border border-neutral-100 shadow-sm hover:shadow-md transition-all duration-300 w-full max-w-[380px]">
	<!-- Izquierda: Imagen (1x1) -->
	<div class="w-24 h-24 md:w-28 md:h-28 shrink-0 rounded-[18px] overflow-hidden bg-neutral-50 border border-neutral-50 flex items-center justify-center p-0">
		<img 
			src={image && image !== "" ? image : fallbackImage} 
			alt={name} 
			class={`w-full h-full object-cover ${!image || image === "" ? "p-6 object-contain opacity-40 grayscale" : ""}`}
		/>
	</div>

	<!-- Derecha: 3 Filas -->
	<div class="flex flex-col justify-between h-24 md:h-28 py-1 flex-grow pr-2">
		<!-- Fila 1: Redes Sociales -->
		<div class="flex justify-end gap-2">
			{linkedin && linkedin !== "" && (
				<a href={linkedin} target="_blank" rel="noopener noreferrer" class="text-primary hover:scale-110 transition-transform">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
				</a>
			)}
			{twitter && twitter !== "" && (
				<a href={twitter} target="_blank" rel="noopener noreferrer" class="text-primary hover:scale-110 transition-transform">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
				</a>
			)}
		</div>

		<!-- Fila 2: Nombre -->
		<h4 class="text-xl md:text-2xl font-bold text-primary leading-tight">
			{name}
		</h4>

		<!-- Fila 3: Cargo -->
		<p class="text-xs md:text-sm font-medium text-primary/70 leading-none truncate">
			{role}
		</p>
	</div>
</div>
