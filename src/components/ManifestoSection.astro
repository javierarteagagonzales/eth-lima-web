---
import SectionContainer from "./SectionContainer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SectionContainer id="manifiesto" class="bg-[var(--color-bg-2)] pt-40 pb-24 min-h-screen flex items-center justify-center">
	<div class="flex flex-col items-center text-center gap-12 max-w-4xl mx-auto w-full">
		<!-- Typography Content -->
		<div class="flex flex-col gap-6">
			<h2 class="text-4xl sm:text-6xl md:text-7xl font-bold leading-[0.85] tracking-tighter text-[var(--color-primary)] flex items-center justify-center gap-4 sm:gap-6">
				<span class="w-3 h-3 sm:w-6 sm:h-6 md:w-8 md:h-8 bg-[var(--color-primary)] rotate-45 shrink-0"></span>
				{t('manifesto.title')}
				<span class="w-3 h-3 sm:w-6 sm:h-6 md:w-8 md:h-8 bg-[var(--color-primary)] rotate-45 shrink-0"></span>
			</h2>
			<p class="text-lg md:text-2xl text-[#475569] leading-tight font-medium max-w-xl mx-auto">
				{t('manifesto.description')}
			</p>
		</div>

		<!-- Box Image Detail -->
		<div class="w-full max-w-[280px] md:max-w-xs aspect-square bg-neutral-800 rounded-[40px] shadow-2xl relative overflow-hidden group mt-4 flex items-center justify-center p-20">
			<div class="absolute inset-0 bg-gradient-to-tr from-primary/30 to-transparent"></div>
			<img src="/eth-lima-web/logo/EthLima.webp" alt="Logo" class="relative z-10 w-full h-full object-contain opacity-40 group-hover:opacity-100 transition-opacity" />
		</div>
	</div>
</SectionContainer>
