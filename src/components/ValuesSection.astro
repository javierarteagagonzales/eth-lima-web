---
import SectionContainer from "./SectionContainer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SectionContainer class="min-h-screen flex items-center justify-center pt-40 pb-24">
	<div class="flex flex-col gap-12 text-center max-w-5xl mx-auto">
		<h2 class="text-3xl md:text-5xl font-bold text-primary tracking-tight underline decoration-primary/30 decoration-4 underline-offset-8">
			{t('team.values.title')}
		</h2>

		<div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
			{[1, 2, 3, 4].map(() => (
				<div class="bg-neutral-100 p-6 md:p-8 rounded-[30px] flex flex-col items-center justify-between aspect-square group hover:bg-primary transition-colors duration-500">
					<h3 class="text-lg md:text-xl font-bold text-primary group-hover:text-white transition-colors uppercase tracking-widest leading-none self-start">
						{t('team.values.label')}
					</h3>
					<div class="w-10 h-10 md:w-12 md:h-12 bg-neutral-300 rounded-full self-end group-hover:bg-white transition-colors flex items-center justify-center p-2.5">
						<img src="/eth-lima-web/logo/EthLima.webp" alt="Logo" class="w-full h-full object-contain opacity-50 group-hover:opacity-100 transition-opacity" />
					</div>
				</div>
			))}
		</div>
	</div>
</SectionContainer>
